{
    "require-dev": {
        "phpstan/phpstan": "^2",
        "pestphp/pest": "^3",
        "nunomaduro/phpinsights": "^2"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Src\\": "src/",
            "Tests\\": "tests/"
        }
    },
    "require": {
        "vlucas/phpdotenv": "^5.6",
        "ramsey/uuid": "^4.7",
        "guzzlehttp/guzzle": "^7.9",
        "slim/slim": "4.*",
        "slim/psr7": "^1.7"
    },
    "scripts": {
        "rall": [
            "@test",
            "@lint",
            "@insights"
        ],
        "test": "vendor/bin/pest --coverage",
        "test:compact": "vendor/bin/pest --coverage --compact",
        "lint": "vendor/bin/phpstan analyse src tests --level max",
        "insights": "vendor/bin/phpinsights"
    }
}
